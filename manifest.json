{
  "manifest_version": 3,
  "name": "Page Tweaks",
  "version": "1.10.0",
  "description": "Poprawki wyglądu i czytelności ulubionych stron.",
  "permissions": ["storage", "declarativeNetRequest", "activeTab", "scripting", "offscreen", "clipboardWrite", "contextMenus", "webNavigation"],
  "background": { "service_worker": "wspolne/background.js" },
  "commands": {
    "kopiuj-link": {
      "suggested_key": { "default": "Ctrl+Shift+C", "mac": "Command+Shift+C" },
      "description": "Kopiuj link bieżącej karty"
    }
  },
  "action": {
    "default_title": "Page Tweaks — ustawienia",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": [
        "https://medium.com/*", "https://*.medium.com/*",
        "https://levelup.gitconnected.com/*", "https://itnext.io/*", "https://*.plainenglish.io/*",
        "https://blog.stackademic.com/*", "https://blog.devgenius.io/*", "https://betterprogramming.pub/*",
        "https://codeburst.io/*", "https://blog.bitsrc.io/*", "https://faun.pub/*", "https://towardsdev.com/*"
      ],
      "exclude_matches": ["https://help.medium.com/*"],
      "js": ["wspolne/ciemny-motyw.js", "strony/medium/medium-dark.js", "strony/medium/medium-tytul.js"],
      "css": ["strony/medium/medium-dark.css", "strony/medium/medium-tytul.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://qnews.pl/*", "https://www.qnews.pl/*"],
      "js": ["wspolne/ciemny-motyw.js", "strony/qnews/qnews-dark.js"],
      "css": ["strony/qnews/qnews-dark.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://limanowa.in/*", "https://www.limanowa.in/*"],
      "js": ["strony/limanowa/limanowa-czytnik.js", "strony/limanowa/limanowa-daty.js", "wspolne/ciemny-motyw.js", "strony/limanowa/limanowa-dark.js"],
      "css": ["strony/limanowa/limanowa-czytnik.css", "strony/limanowa/limanowa-daty.css", "strony/limanowa/limanowa-dark.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://rmf24.pl/*", "https://www.rmf24.pl/*"],
      "js": ["strony/rmf24/rmf24-bez-reklam.js", "strony/rmf24/rmf24-wpisy.js", "strony/rmf24/rmf24-panele.js", "strony/rmf24/rmf24-daty.js", "strony/rmf24/rmf24-przeczytane.js", "strony/rmf24/rmf24-dark.js"],
      "css": ["strony/rmf24/rmf24-bez-reklam.css", "strony/rmf24/rmf24-wpisy.css", "strony/rmf24/rmf24-panele.css", "strony/rmf24/rmf24-daty.css", "strony/rmf24/rmf24-przeczytane.css", "strony/rmf24/rmf24-dark.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://ehms.pk.edu.pl/*"],
      "js": ["wspolne/ciemny-motyw.js", "strony/ehms/ehms-dark.js", "strony/ehms/ehms-wyglad.js"],
      "css": ["strony/ehms/ehms-wyglad.css", "strony/ehms/ehms-dark.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["nazwy-kart/nazwa-karty.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "limanowa", "enabled": true, "path": "strony/limanowa/limanowa-reguly.json" },
      { "id": "rmf24", "enabled": true, "path": "strony/rmf24/rmf24-reguly.json" }
    ]
  },
  "options_page": "wspolne/options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
