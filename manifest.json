{
  "manifest_version": 3,
  "name": "Page Tweaks",
  "version": "1.3.0",
  "description": "Poprawki cudzych stron: ciemny motyw dla medium.com i qnews.pl, czytnik bez reklam i daty wpisów dla limanowa.in, rmf24.pl bez reklam i bocznych paneli, z wpisami z X za przyciskiem.",
  "permissions": ["storage", "declarativeNetRequest"],
  "background": { "service_worker": "wspolne/background.js" },
  "action": {
    "default_title": "Page Tweaks — ustawienia",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": [
        "https://medium.com/*", "https://*.medium.com/*",
        "https://levelup.gitconnected.com/*", "https://itnext.io/*", "https://*.plainenglish.io/*",
        "https://blog.stackademic.com/*", "https://blog.devgenius.io/*", "https://betterprogramming.pub/*",
        "https://codeburst.io/*", "https://blog.bitsrc.io/*", "https://faun.pub/*", "https://towardsdev.com/*"
      ],
      "exclude_matches": ["https://help.medium.com/*"],
      "js": ["wspolne/ciemny-motyw.js", "strony/medium/medium-dark.js"],
      "css": ["strony/medium/medium-dark.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://qnews.pl/*", "https://www.qnews.pl/*"],
      "js": ["wspolne/ciemny-motyw.js", "strony/qnews/qnews-dark.js"],
      "css": ["strony/qnews/qnews-dark.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://limanowa.in/*", "https://www.limanowa.in/*"],
      "js": ["strony/limanowa/limanowa-czytnik.js", "strony/limanowa/limanowa-daty.js"],
      "css": ["strony/limanowa/limanowa-czytnik.css", "strony/limanowa/limanowa-daty.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://rmf24.pl/*", "https://www.rmf24.pl/*"],
      "js": ["strony/rmf24/rmf24-bez-reklam.js", "strony/rmf24/rmf24-wpisy.js", "strony/rmf24/rmf24-panele.js"],
      "css": ["strony/rmf24/rmf24-bez-reklam.css", "strony/rmf24/rmf24-wpisy.css", "strony/rmf24/rmf24-panele.css"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "limanowa", "enabled": true, "path": "strony/limanowa/limanowa-reguly.json" },
      { "id": "rmf24", "enabled": true, "path": "strony/rmf24/rmf24-reguly.json" }
    ]
  },
  "options_page": "wspolne/options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
